# --- Database ---
DATABASE_URL=postgresql+psycopg2://tallynorth:tallynorth@localhost:5432/tallynorth
ENVIRONMENT=development

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Application locale ---
APP_TIMEZONE=America/Buenos_Aires

# --- ChatGPT Actions ---
# Public URL up to the API version, without a trailing slash.
# Local: http://localhost:8000/api/v1
# Vercel example: https://your-domain.example/api/v1
# CHATGPT_ACTION_BASE_URL=

# --- CORS (optional) ---
# FRONTEND_URL=https://tally-north.vercel.app
# ALLOW_ALL_ORIGINS=False

# --- OpenAI Agents ---
# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=gpt-4.1-mini
# OPENAI_AGENTS_DISABLE_TRACING=1
